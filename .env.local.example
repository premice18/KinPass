# Copier ce fichier en `.env.local` puis renseigner la valeur réelle.
# URL de connexion Neon (poolée), ex. postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
PEXELS_API_KEY="YOUR_PEXELS_API_KEY"
# Clé de signature des sessions (auth). Générer une valeur longue : ex.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET="YOUR_LONG_RANDOM_SECRET"
# OAuth Google (optionnel) — Google Cloud Console > Identifiants OAuth.
AUTH_GOOGLE_ID="xxxx-xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"
# URL publique du site (partage WhatsApp + aperçus OG des pages /e/[slug]).
# Ex. "https://kinpass.app" en production ; repli local : http://localhost:3000
NEXT_PUBLIC_APP_URL="https://kinpass.app"
# Remise des billets par email (Phase 6.3) — OPTIONNEL en développement :
# sans clé, l'envoi est simulé (log). Installer le SDK : pnpm add resend
RESEND_API_KEY="re_YOUR_API_KEY"
MAIL_FROM="kinPass <billets@kinpass.app>"
# Paiement Mobile Money — KPay (Phase 6.4). Clés de TEST : kpay_test_... / sk_test_...
# Sans clés, le checkout bascule en mode « Simuler le paiement » (démo/E2E).
KPAY_API_KEY="kpay_test_xxxxxxxx"
KPAY_SECRET_KEY="sk_test_xxxxxxxx"
# Secret du callback Webhook « Dépôts » configuré sur le dashboard KPay.
KPAY_WEBHOOK_SECRET="votre-secret-webhook"
# Taux USD -> CDF appliqué pour facturer en CDF les billets libellés en USD
# (KPay COD : montant sans paramètre de devise). Ajustable, vrai taux en Phase 10.
KPAY_USD_CDF_RATE="2800"
